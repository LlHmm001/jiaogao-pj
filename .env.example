# OCR 服务地址（PaddleOCR / EasyOCR）
OCR_ENDPOINT=http://localhost:8866

# OCR 请求超时 (ms)
OCR_TIMEOUT=30000

# Playwright 浏览器（仅 URL 模式: chromium / firefox / webkit）
BROWSER_TYPE=chromium

# --- LLM 语义对比（可选，需要大模型 API Key）---
# 支持任何 OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问 / 智谱 / Ollama 等）
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o
# LLM_TIMEOUT=30000
