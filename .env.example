# Web 服务端口
PORT=3100

# OCR 服务地址（EasyOCR / PaddleOCR）
OCR_ENDPOINT=http://localhost:8866

# OCR 请求超时 (ms)
OCR_TIMEOUT=30000

# Playwright 浏览器（chromium / firefox / webkit）
BROWSER_TYPE=chromium

# --- LLM 语义审核（可选）---
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_TIMEOUT=30000
